# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# Application public base URL (used for password reset emails and OAuth redirects)
APP_BASE_URL=""

# StorageOS Configuration
# Cryptographic secret for signing session cookies and CSRF tokens (can use SECRET_KEY or STORAGEOS_SECRET_KEY)
SECRET_KEY=""
STORAGEOS_SECRET_KEY=""
# Storage quota per user in bytes or human readable (default 1GB = 1073741824)
STORAGEOS_QUOTA=1073741824
# Base directory for user file storage (default: /storage or app/data/storage)
STORAGEOS_STORAGE_ROOT="/storage"
# Database file location (default: app/data/storageos.db)
STORAGEOS_DATABASE_PATH="app/data/storageos.db"
# Session cookie settings (auto-detected when unset; set explicitly if needed)
SESSION_COOKIE_SECURE="False"
SESSION_COOKIE_SAMESITE="Lax"

# Google OAuth 2.0 / OIDC Configuration
# Obtain credentials from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override for the redirect URI (defaults to {APP_BASE_URL}/google/callback)
GOOGLE_REDIRECT_URI=""

# SMTP / Email Delivery Configuration (Password Reset & Notifications)
# If unconfigured, StorageOS operates in development mode and logs reset URLs to server logs
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="StorageOS Cloud"
SMTP_USE_TLS="True"
SMTP_USE_SSL="False"

